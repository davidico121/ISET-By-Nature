{% comment %}
  ISET by Nature: "Quality You Can Trust" section - light background, bold heading,
  body copy, and a grid of "free from" claims each with an X badge. Mobile-first:
  base styles target small screens, desktop scales up via min-width.
  Custom section with full schema controls (blocks for the claim list).
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .ip-trust {
    background: {{ section.settings.background_color }};
    font-family: var(--font-body-family);
  }
  #shopify-section-{{ section.id }} .ip-wrap {
    width: min(900px, calc(100% - 28px));
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .ip-trust h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(26px, 4.5vw, 44px);
    font-weight: 900;
    margin: 0 0 16px;
    color: {{ section.settings.heading_color }};
    line-height: 1.1;
  }
  #shopify-section-{{ section.id }} .ip-trust-body {
    font-size: 15px;
    line-height: 1.6;
    color: {{ section.settings.body_color }};
    margin: 0 auto 28px;
    max-width: 600px;
  }
  #shopify-section-{{ section.id }} .ip-trust-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    max-width: 560px;
    margin: 0 auto 28px;
    text-align: left;
  }
  #shopify-section-{{ section.id }} .ip-trust-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  #shopify-section-{{ section.id }} .ip-trust-badge {
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    border: 2px solid {{ section.settings.badge_color }};
    color: {{ section.settings.badge_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 900;
  }
  #shopify-section-{{ section.id }} .ip-trust-claim {
    font-size: 15px;
    font-weight: 600;
    color: {{ section.settings.claim_text_color }};
  }
  #shopify-section-{{ section.id }} .ip-trust-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 4px;
    padding: 14px 34px;
    border-radius: 999px;
    background: {{ section.settings.cta_bg_color }};
    color: {{ section.settings.cta_text_color }};
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .ip-trust-cta:hover {
    opacity: 0.88;
  }

  @media screen and (min-width: 600px) {
    #shopify-section-{{ section.id }} .ip-trust-grid {
      grid-template-columns: 1fr 1fr;
      gap: 16px 32px;
      justify-items: start;
    }
    #shopify-section-{{ section.id }} .ip-trust-body {
      font-size: 17px;
    }
    #shopify-section-{{ section.id }} .ip-trust-claim {
      font-size: 16px;
    }
  }
</style>

<div class="ip-trust">
  <div class="ip-wrap">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <p class="ip-trust-body">{{ section.settings.body | escape }}</p>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="ip-trust-grid">
        {%- for block in section.blocks -%}
          <div class="ip-trust-item" {{ block.shopify_attributes }}>
            <span class="ip-trust-badge" aria-hidden="true">&#10005;</span>
            <span class="ip-trust-claim">{{ block.settings.claim_text | escape }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if section.settings.show_cta and section.settings.cta_label != blank -%}
      <a href="#MainContent" class="ip-trust-cta" data-scroll-to-top>{{ section.settings.cta_label | escape }}</a>
    {%- endif -%}
  </div>
</div>

<script>
  (function() {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    var trigger = section.querySelector('[data-scroll-to-top]');
    if (!trigger) return;
    trigger.addEventListener('click', function(e) {
      var target = document.getElementById('MainContent');
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "ISET Quality Trust",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Quality You Can Trust"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#f5f0e8"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Herbal Iron Capsules are wildcrafted and prepared the traditional way, with nothing synthetic added. No fillers. No shortcuts. Just roots."
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#ffffffa6"
    },
    {
      "type": "header",
      "content": "Claim badges"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "X badge color",
      "default": "#8aab35"
    },
    {
      "type": "color",
      "id": "claim_text_color",
      "label": "Claim text color",
      "default": "#f5f0e8"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show call-to-action button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop Now",
      "info": "Scrolls back up to the buy box."
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "Button background",
      "default": "#f5f0e8"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text color",
      "default": "#1c2a0f"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1c2a0f"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "claim",
      "name": "Claim",
      "settings": [
        {
          "type": "text",
          "id": "claim_text",
          "label": "Claim text",
          "default": "No synthetic fillers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ISET Quality Trust",
      "blocks": [
        { "type": "claim" },
        { "type": "claim" },
        { "type": "claim" },
        { "type": "claim" }
      ]
    }
  ]
}
{% endschema %}
