{% comment %}
  ISET by Nature: Guarantee/consistency message block.
  Matches the tea page's dark, centered icon+headline+body component. Custom section with full schema controls.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .ip-guarantee {
    background: {{ section.settings.background_color }};
    font-family: var(--font-body-family);
  }
  #shopify-section-{{ section.id }} .ip-wrap {
    width: min(1100px, calc(100% - 28px));
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .ip-guarantee-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    max-width: 620px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .ip-guarantee-icon {
    font-size: 52px;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .ip-guarantee h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(22px, 3.2vw, 36px);
    font-weight: 900;
    margin: 0;
    color: {{ section.settings.heading_color }};
    line-height: 1.15;
  }
  #shopify-section-{{ section.id }} .ip-guarantee p {
    font-size: 14px;
    line-height: 1.65;
    color: {{ section.settings.body_color }};
    margin: 0;
  }
  #shopify-section-{{ section.id }} .ip-guarantee-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
    padding: 13px 32px;
    border-radius: 999px;
    background: {{ section.settings.cta_bg_color }};
    color: {{ section.settings.cta_text_color }};
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .ip-guarantee-cta:hover {
    opacity: 0.88;
  }
</style>

<div class="ip-guarantee">
  <div class="ip-wrap">
    <div class="ip-guarantee-inner">
      {%- if section.settings.icon != blank -%}
        <div class="ip-guarantee-icon">{{ section.settings.icon }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <p>{{ section.settings.body | escape }}</p>
      {%- endif -%}
      {%- if section.settings.show_cta and section.settings.cta_label != blank -%}
        <a href="#MainContent" class="ip-guarantee-cta" data-scroll-to-top>{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function() {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    var trigger = section.querySelector('[data-scroll-to-top]');
    if (!trigger) return;
    trigger.addEventListener('click', function(e) {
      var target = document.getElementById('MainContent');
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "ISET Guarantee",
  "settings": [
    {
      "type": "text",
      "id": "icon",
      "label": "Icon (emoji)",
      "default": "🛡️"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for the long run, not the quick fix."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#f5f0e8"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Real roots don't work like a stimulant. Take Herbal Iron Capsules daily, the way it's traditionally made: a tonic, not a shortcut. Results vary from person to person."
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#ffffffa6"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show call-to-action button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop Now",
      "info": "Scrolls back up to the buy box."
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "Button background",
      "default": "#f5f0e8"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text color",
      "default": "#1c2a0f"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1c2a0f"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "ISET Guarantee"
    }
  ]
}
{% endschema %}
