{% comment %}
  ISET by Nature — Trust Bar Section
  File: sections/iset-trust-bar.liquid
  Upload to: Shopify Admin → Online Store → Themes → Edit code → sections/
  Then add to your homepage via the theme editor (Add section → ISET Trust Bar)
{% endcomment %}

<div class="iset-trust-bar" style="background-color: {{ section.settings.background_color }};">
  <div class="iset-trust-bar__inner">
    {% for block in section.blocks %}
      {% if block.type == 'trust_item' %}
        <div class="iset-trust-bar__item" {{ block.shopify_attributes }}>
          <div class="iset-trust-bar__icon">
            {% if block.settings.icon == 'leaf' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c4.97-4.97 7-9 7-13A7 7 0 0 0 5 9c0 4 2.03 8.03 7 13z"/><path d="M12 22V12"/></svg>
            {% elsif block.settings.icon == 'shield' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
            {% elsif block.settings.icon == 'truck' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            {% elsif block.settings.icon == 'star' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {% elsif block.settings.icon == 'herb' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 20h10"/><path d="M10 20c0-5.5 4-10 4-10s4 4.5 4 10"/><path d="M6 10s-2 3-2 6h8c0-3-2-6-2-6z"/></svg>
            {% elsif block.settings.icon == 'recycle' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 19H4.815a1.83 1.83 0 0 1-1.57-.881 1.785 1.785 0 0 1-.004-1.784L7.196 9.5"/><path d="M11 19h8.203a1.83 1.83 0 0 0 1.556-.89 1.784 1.784 0 0 0 0-1.775l-1.226-2.12"/><path d="m14 16-3 3 3 3"/><path d="M8.293 13.596 7.196 9.5 3.1 10.598"/><path d="m9.344 5.811 1.093-1.892A1.83 1.83 0 0 1 11.985 3a1.784 1.784 0 0 1 1.546.888l3.943 6.843"/><path d="m13.378 9.633 4.096 1.098 1.097-4.096"/></svg>
            {% elsif block.settings.icon == 'heart' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            {% elsif block.settings.icon == 'globe' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            {% endif %}
          </div>
          <div class="iset-trust-bar__text">
            {% if block.settings.line1 != blank %}
              <span>{{ block.settings.line1 }}</span>
            {% endif %}
            {% if block.settings.line2 != blank %}
              <span>{{ block.settings.line2 }}</span>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .iset-trust-bar {
    width: 100%;
    padding: 20px 20px;
    border-top: 1px solid rgba(0,0,0,0.06);
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }

  .iset-trust-bar__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(var(--trust-cols, 4), 1fr);
    gap: 16px;
  }

  .iset-trust-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-align: center;
    padding: 0px 4px;
  }

  .iset-trust-bar__icon {
    width: 34px;
    height: 34px;
    color: {{ section.settings.icon_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .iset-trust-bar__icon svg {
    width: 100%;
    height: 100%;
  }

  .iset-trust-bar__text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .iset-trust-bar__text span {
    display: block;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    color: {{ section.settings.text_color }};
    letter-spacing: 0.01em;
  }

  @media (max-width: 768px) {
    .iset-trust-bar__inner {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .iset-trust-bar {
      padding: 16px;
    }
  }

  @media (max-width: 400px) {
    .iset-trust-bar__inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ISET Trust Bar",
  "tag": "section",
  "class": "iset-trust-bar-section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f7f3eb"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#4a6b1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#3a5214"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf",    "label": "Leaf (wildcrafted)" },
            { "value": "shield",  "label": "Shield (no fillers)" },
            { "value": "truck",   "label": "Truck (shipping)" },
            { "value": "star",    "label": "Star (reviews)" },
            { "value": "herb",    "label": "Herb (natural)" },
            { "value": "recycle", "label": "Recycle (sustainable)" },
            { "value": "heart",   "label": "Heart (wellness)" },
            { "value": "globe",   "label": "Globe (Jamaica sourced)" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "line1",
          "label": "Line 1",
          "default": "Wildcrafted"
        },
        {
          "type": "text",
          "id": "line2",
          "label": "Line 2",
          "default": "from source"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ISET Trust Bar",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "icon": "leaf",
            "line1": "Wildcrafted",
            "line2": "from source"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "shield",
            "line1": "No fillers",
            "line2": "or additives"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "truck",
            "line1": "Ships from",
            "line2": "US warehouse"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "star",
            "line1": "500+ verified",
            "line2": "reviews"
          }
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}