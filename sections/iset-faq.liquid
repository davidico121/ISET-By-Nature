{% comment %}
  ISET by Nature: FAQ accordion.
  Matches the tea page's ip-faq component (serif summary + plus/minus, divider rows). Custom section with full schema controls.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .ip-faq-section {
    background: {{ section.settings.background_color }};
    font-family: var(--font-body-family);
  }
  #shopify-section-{{ section.id }} .ip-wrap {
    width: min(1100px, calc(100% - 28px));
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .ip-faq-wrap {
    max-width: 820px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .ip-eyebrow {
    color: {{ section.settings.eyebrow_color }};
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    margin-bottom: 10px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .ip-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(26px, 4vw, 48px);
    line-height: 1.06;
    font-weight: 900;
    margin: 0 0 28px;
    color: {{ section.settings.heading_color }};
    text-align: center;
  }
  #shopify-section-{{ section.id }} .ip-faq details {
    border-bottom: 1px solid {{ section.settings.border_color }};
    padding: 16px 0;
  }
  #shopify-section-{{ section.id }} .ip-faq summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 16px;
    line-height: 1.35;
    font-weight: 700;
    color: {{ section.settings.question_color }};
  }
  #shopify-section-{{ section.id }} .ip-faq summary::-webkit-details-marker {
    display: none;
  }
  #shopify-section-{{ section.id }} .ip-faq summary:after {
    content: "+";
    font-size: 20px;
    color: {{ section.settings.icon_color }};
    flex: 0 0 auto;
    font-family: var(--font-body-family);
  }
  #shopify-section-{{ section.id }} .ip-faq details[open] summary:after {
    content: "\2212";
  }
  #shopify-section-{{ section.id }} .ip-faq details p {
    color: {{ section.settings.answer_color }};
    font-size: 14px;
    line-height: 1.65;
    margin: 10px 0 0;
  }
</style>

<div class="ip-faq-section">
  <div class="ip-wrap">
    <div class="ip-faq-wrap">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <div class="ip-eyebrow">{{ section.settings.eyebrow | escape }}</div>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="ip-title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="ip-faq">
        {%- for block in section.blocks -%}
          <details {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question | escape }}</summary>
            <p>{{ block.settings.answer }}</p>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ISET FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#4a6b1a"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your questions, answered"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1c2a0f"
    },
    {
      "type": "header",
      "content": "Row styling"
    },
    {
      "type": "color",
      "id": "question_color",
      "label": "Question color",
      "default": "#1c2a0f"
    },
    {
      "type": "color",
      "id": "answer_color",
      "label": "Answer color",
      "default": "#5a7040"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Plus/minus icon color",
      "default": "#4a6b1a"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider color",
      "default": "#4a6b1a2e"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f7f3eb"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ISET FAQ",
      "blocks": [
        { "type": "qa" },
        { "type": "qa" },
        { "type": "qa" }
      ]
    }
  ]
}
{% endschema %}
