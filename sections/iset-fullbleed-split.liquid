{% comment %}
  ISET by Nature: Full-bleed image/text split
  Custom section, not a native Shopify section type.
{% endcomment %}

{%- liquid
  assign img_side = section.settings.image_position
-%}

<style>
  #shopify-section-{{ section.id }} .ifs-section {
    --ifs-text: #1c2a0f;
    --ifs-muted: #5a7040;
    --ifs-bg: {{ section.settings.background_color }};
    background: var(--ifs-bg);
    font-family: Inter, Arial, sans-serif;
  }
  #shopify-section-{{ section.id }} .ifs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: {{ section.settings.min_height }}px;
  }
  #shopify-section-{{ section.id }} .ifs-media {
    order: {% if img_side == 'left' %}1{% else %}2{% endif %};
    position: relative;
    overflow: hidden;
    background: #eef6d8;
  }
  #shopify-section-{{ section.id }} .ifs-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .ifs-media .ifs-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 54px;
    color: #4a6b1a;
  }
  #shopify-section-{{ section.id }} .ifs-copy {
    order: {% if img_side == 'left' %}2{% else %}1{% endif %};
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 64px 7%;
  }
  #shopify-section-{{ section.id }} .ifs-copy-inner {
    max-width: 440px;
  }
  #shopify-section-{{ section.id }} .ifs-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(26px, 4vw, 48px);
    line-height: 1.06;
    font-weight: 900;
    margin: 0 0 14px;
    color: var(--ifs-text);
  }
  #shopify-section-{{ section.id }} .ifs-sub {
    font-size: 15px;
    line-height: 1.5;
    color: var(--ifs-muted);
    margin: 0 0 18px;
  }
  #shopify-section-{{ section.id }} .ifs-body {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ifs-text);
    margin: 0;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .ifs-grid {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    #shopify-section-{{ section.id }} .ifs-media {
      order: 1;
      aspect-ratio: 4 / 3;
    }
    #shopify-section-{{ section.id }} .ifs-copy {
      order: 2;
      padding: 40px 24px;
    }
  }
</style>

<div class="ifs-section">
  <div class="ifs-grid">
    <div class="ifs-media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '50vw' }}
      {%- else -%}
        <div class="ifs-placeholder">{{ section.settings.placeholder_icon }}</div>
      {%- endif -%}
    </div>
    <div class="ifs-copy">
      <div class="ifs-copy-inner">
        {%- if section.settings.heading != blank -%}
          <h2 class="ifs-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ifs-sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <p class="ifs-body">{{ section.settings.body | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ISET Full-bleed split",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "placeholder_icon",
      "label": "Placeholder icon (shown if no image)",
      "default": "☕"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height (desktop)",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f7f3eb"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Part of the morning."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text"
    }
  ],
  "presets": [
    {
      "name": "ISET Full-bleed split"
    }
  ]
}
{% endschema %}
