{% comment %}
  ISET by Nature: Spec-sheet style fact table (checklist rows about this product only).
  Deliberately not a competitor comparison table. Custom section with full schema controls.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .ip-spec {
    background: {{ section.settings.background_color }};
    font-family: Inter, Arial, sans-serif;
  }
  #shopify-section-{{ section.id }} .ip-wrap {
    width: min(820px, calc(100% - 28px));
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .ip-head {
    max-width: 620px;
    margin: 0 auto 28px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .ip-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(24px, 3.6vw, 36px);
    line-height: 1.1;
    font-weight: 900;
    margin: 0;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .ip-sub {
    font-size: 16px;
    line-height: 1.6;
    color: {{ section.settings.subheading_color }};
    margin: 10px 0 0;
  }
  #shopify-section-{{ section.id }} .ip-spec-table {
    background: {{ section.settings.row_background }};
    border: 1px solid {{ section.settings.border_color }};
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 14px 34px rgba(28,42,15,0.08);
  }
  #shopify-section-{{ section.id }} .ip-spec-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 18px 24px;
    border-bottom: 1px solid {{ section.settings.border_color }};
  }
  #shopify-section-{{ section.id }} .ip-spec-row:last-child {
    border-bottom: none;
  }
  #shopify-section-{{ section.id }} .ip-spec-label {
    font-size: 15px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .ip-spec-value {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: {{ section.settings.check_color }};
    text-align: right;
    justify-content: flex-end;
  }
  #shopify-section-{{ section.id }} .ip-spec-check {
    width: 20px;
    height: 20px;
    min-width: 20px;
    border-radius: 999px;
    background: {{ section.settings.check_color }};
    color: {{ section.settings.row_background }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 900;
  }
  @media screen and (max-width: 500px) {
    #shopify-section-{{ section.id }} .ip-spec-row {
      grid-template-columns: 1fr;
      text-align: left;
      gap: 6px;
    }
    #shopify-section-{{ section.id }} .ip-spec-value {
      justify-content: flex-start;
    }
  }
</style>

<div class="ip-spec">
  <div class="ip-wrap">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ip-head">
        {%- if section.settings.heading != blank -%}
          <h2 class="ip-title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ip-sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="ip-spec-table">
        {%- for block in section.blocks -%}
          <div class="ip-spec-row" {{ block.shopify_attributes }}>
            <div class="ip-spec-label">{{ block.settings.label | escape }}</div>
            <div class="ip-spec-value">
              <span class="ip-spec-check">&#10003;</span>
              {{ block.settings.value | escape }}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "ISET Spec table",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The ISET Standard"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading / label color",
      "default": "#1c2a0f"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#5a7040"
    },
    {
      "type": "header",
      "content": "Table styling"
    },
    {
      "type": "color",
      "id": "row_background",
      "label": "Row background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider color",
      "default": "#4a6b1a2e"
    },
    {
      "type": "color",
      "id": "check_color",
      "label": "Checkmark + value color",
      "default": "#4a6b1a"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color",
      "default": "#f7f3eb"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Label"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "Value"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ISET Spec table",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
