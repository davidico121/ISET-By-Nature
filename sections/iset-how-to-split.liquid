{% comment %}
  ISET by Nature: Lifestyle image split with eyebrow/heading/subheading and numbered step cards.
  Matches the tea page's "How to make your tonic" module. Custom section with full schema controls.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .ip-lifestyle {
    background: {{ section.settings.background_color }};
    font-family: var(--font-body-family);
  }
  #shopify-section-{{ section.id }} .ip-wrap {
    width: min(1100px, calc(100% - 28px));
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .ip-lifestyle-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px;
    align-items: center;
    {% if section.settings.image_position == 'right' %}
      direction: rtl;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .ip-lifestyle-grid > * {
    direction: ltr;
  }
  #shopify-section-{{ section.id }} .ip-lifestyle-media {
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    border: 1px solid rgba(74,107,26,0.18);
    box-shadow: 0 14px 34px rgba(28,42,15,0.08);
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    background: {{ section.settings.image_placeholder_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 60px;
  }
  #shopify-section-{{ section.id }} .ip-lifestyle-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .ip-eyebrow {
    color: {{ section.settings.eyebrow_color }};
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  #shopify-section-{{ section.id }} .ip-lifestyle-copy h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(24px, 3.4vw, 40px);
    line-height: 1.1;
    font-weight: 900;
    margin: 0 0 10px;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .ip-lifestyle-copy p.ip-subheading {
    color: {{ section.settings.subheading_color }};
    font-size: 16px;
    line-height: 1.65;
    margin: 0 0 16px;
  }
  #shopify-section-{{ section.id }} .ip-steps {
    display: grid;
    gap: 10px;
  }
  #shopify-section-{{ section.id }} .ip-step {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 12px;
    align-items: start;
    background: rgba(255,255,255,0.75);
    border: 1px solid rgba(74,107,26,0.18);
    border-radius: 16px;
    padding: 12px 14px;
  }
  #shopify-section-{{ section.id }} .ip-step-num {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: {{ section.settings.step_num_bg }};
    color: {{ section.settings.step_num_color }};
    display: grid;
    place-items: center;
    font-size: 13px;
    font-weight: 900;
    font-family: 'Playfair Display', Georgia, serif;
  }
  #shopify-section-{{ section.id }} .ip-step strong {
    display: block;
    font-size: 13px;
    font-weight: 800;
    margin-bottom: 2px;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .ip-step span {
    display: block;
    color: {{ section.settings.subheading_color }};
    font-size: 12.5px;
    line-height: 1.45;
  }
  #shopify-section-{{ section.id }} .ip-lifestyle-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 18px;
    padding: 14px 34px;
    border-radius: 999px;
    background: {{ section.settings.cta_bg_color }};
    color: {{ section.settings.cta_text_color }};
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .ip-lifestyle-cta:hover {
    opacity: 0.88;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .ip-lifestyle-grid {
      grid-template-columns: 1fr;
      direction: ltr;
    }
  }
</style>

<div class="ip-lifestyle">
  <div class="ip-wrap">
    <div class="ip-lifestyle-grid">
      <div class="ip-lifestyle-media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '50vw' }}
        {%- else -%}
          <span>{{ section.settings.placeholder_icon }}</span>
        {%- endif -%}
      </div>
      <div class="ip-lifestyle-copy">
        {%- if section.settings.eyebrow != blank -%}
          <div class="ip-eyebrow">{{ section.settings.eyebrow | escape }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ip-subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- assign step_blocks = section.blocks | where: 'type', 'step' -%}
        {%- if step_blocks.size > 0 -%}
          <div class="ip-steps">
            {%- for block in step_blocks -%}
              <div class="ip-step" {{ block.shopify_attributes }}>
                <div class="ip-step-num">{{ forloop.index }}</div>
                <div>
                  {%- if block.settings.title != blank -%}<strong>{{ block.settings.title | escape }}</strong>{%- endif -%}
                  {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'button' and block.settings.button_label != blank -%}
            <a href="#MainContent" class="ip-lifestyle-cta" data-scroll-to-top {{ block.shopify_attributes }}>{{ block.settings.button_label | escape }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    var trigger = section.querySelector('[data-scroll-to-top]');
    if (!trigger) return;
    trigger.addEventListener('click', function(e) {
      var target = document.getElementById('MainContent');
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "ISET Lifestyle + Steps",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "placeholder_icon",
      "label": "Placeholder icon (shown if no image)",
      "default": "☕"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1/1", "label": "Square" },
        { "value": "4/5", "label": "Portrait" },
        { "value": "3/4", "label": "Portrait (tall)" },
        { "value": "4/3", "label": "Landscape" }
      ],
      "default": "4/5"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "image_placeholder_bg",
      "label": "Image placeholder background",
      "default": "#eef6d8"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "How to take it"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#4a6b1a"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to make it part of your morning."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1c2a0f"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "No countdown, no milestones to hit, just a simple daily routine."
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading / step text color",
      "default": "#5a7040"
    },
    {
      "type": "header",
      "content": "Call to action button (optional)"
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "Button background",
      "default": "#1c2a0f"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text color",
      "default": "#f5f0e8"
    },
    {
      "type": "header",
      "content": "Step number badge"
    },
    {
      "type": "color",
      "id": "step_num_bg",
      "label": "Badge background",
      "default": "#1c2a0f"
    },
    {
      "type": "color",
      "id": "step_num_color",
      "label": "Badge number color",
      "default": "#8aab35"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color",
      "default": "#eef6d8"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Step description"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now",
          "info": "Scrolls back up to the buy box."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ISET Lifestyle + Steps",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
