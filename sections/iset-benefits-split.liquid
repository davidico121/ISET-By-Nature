{% comment %}
  ISET by Nature: Benefits infographic (image + heading/subheading + 2x2 icon benefit
  grid), modeled on the Gruns "Whole-Body Support" layout. Mobile-first: base styles
  target small screens (stacked, 1-column grid), desktop scales up via min-width.
  Custom section, fully schema-driven.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .ip-bsplit {
    background: {{ section.settings.background_color }};
    font-family: var(--font-body-family);
  }
  #shopify-section-{{ section.id }} .ip-wrap {
    width: min(1140px, calc(100% - 28px));
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .ip-bsplit-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .ip-bsplit-media {
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: {{ section.settings.image_placeholder_bg }};
    position: relative;
  }
  #shopify-section-{{ section.id }} .ip-bsplit-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .ip-bsplit-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 54px;
  }
  #shopify-section-{{ section.id }} .ip-bsplit-content {
    text-align: center;
  }
  #shopify-section-{{ section.id }} .ip-bsplit-eyebrow {
    color: {{ section.settings.eyebrow_color }};
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  #shopify-section-{{ section.id }} .ip-bsplit-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(24px, 4.2vw, 38px);
    line-height: 1.1;
    font-weight: 900;
    margin: 0 0 12px;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .ip-bsplit-subheading {
    font-size: 15px;
    line-height: 1.6;
    color: {{ section.settings.subheading_color }};
    margin: 0 0 24px;
  }
  #shopify-section-{{ section.id }} .ip-bsplit-benefits {
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
  }
  #shopify-section-{{ section.id }} .ip-bsplit-benefit-icon {
    width: 36px;
    height: 36px;
    margin: 0 auto 8px;
  }
  #shopify-section-{{ section.id }} .ip-bsplit-benefit-icon svg {
    width: 100%;
    height: 100%;
    stroke: {{ section.settings.icon_color }};
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  #shopify-section-{{ section.id }} .ip-bsplit-benefit-title {
    font-size: 15px;
    font-weight: 800;
    color: {{ section.settings.benefit_title_color }};
    margin: 0 0 4px;
  }
  #shopify-section-{{ section.id }} .ip-bsplit-benefit-desc {
    font-size: 13px;
    line-height: 1.5;
    color: {{ section.settings.benefit_desc_color }};
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .ip-bsplit-grid {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
      {% if section.settings.image_position == 'right' %}
        direction: rtl;
      {% endif %}
    }
    #shopify-section-{{ section.id }} .ip-bsplit-grid > * {
      direction: ltr;
    }
    #shopify-section-{{ section.id }} .ip-bsplit-content {
      text-align: left;
    }
    #shopify-section-{{ section.id }} .ip-bsplit-subheading {
      text-align: left;
      font-size: 16px;
    }
    #shopify-section-{{ section.id }} .ip-bsplit-benefits {
      grid-template-columns: 1fr 1fr;
      gap: 26px 32px;
    }
    #shopify-section-{{ section.id }} .ip-bsplit-benefit-icon {
      margin: 0 0 8px;
    }
  }
</style>

<div class="ip-bsplit">
  <div class="ip-wrap">
    <div class="ip-bsplit-grid">
      <div class="ip-bsplit-media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '50vw' }}
        {%- else -%}
          <div class="ip-bsplit-placeholder">{{ section.settings.placeholder_icon }}</div>
        {%- endif -%}
      </div>
      <div class="ip-bsplit-content">
        {%- if section.settings.eyebrow != blank -%}
          <div class="ip-bsplit-eyebrow">{{ section.settings.eyebrow | escape }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ip-bsplit-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ip-bsplit-subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <div class="ip-bsplit-benefits">
            {%- for block in section.blocks -%}
              <div class="ip-bsplit-benefit" {{ block.shopify_attributes }}>
                <div class="ip-bsplit-benefit-icon">
                  {%- case block.settings.icon -%}
                    {%- when 'energy' -%}
                      <svg viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                    {%- when 'strength' -%}
                      <svg viewBox="0 0 24 24"><line x1="6" y1="12" x2="18" y2="12"/><rect x="2" y="8" width="4" height="8" rx="1"/><rect x="18" y="8" width="4" height="8" rx="1"/></svg>
                    {%- when 'shield' -%}
                      <svg viewBox="0 0 24 24"><path d="M12 2l8 4v5c0 5-3.5 8.5-8 11-4.5-2.5-8-6-8-11V6l8-4z"/><path d="M9 12l2 2 4-4"/></svg>
                    {%- when 'leaf' -%}
                      <svg viewBox="0 0 24 24"><path d="M12 22c0 0 8-4 8-10a8 8 0 0 0-16 0c0 6 8 10 8 10z"/><path d="M12 22V12"/></svg>
                    {%- when 'heart' -%}
                      <svg viewBox="0 0 24 24"><path d="M12 21s-7-4.35-9.5-8.5C.5 9 2 5 6 5c2 0 3.5 1.2 4 2.5C10.5 6.2 12 5 14 5c4 0 5.5 4 3.5 7.5C19 16.65 12 21 12 21z"/></svg>
                    {%- when 'brain' -%}
                      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/></svg>
                  {%- endcase -%}
                </div>
                {%- if block.settings.title != blank -%}
                  <p class="ip-bsplit-benefit-title">{{ block.settings.title | escape }}</p>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="ip-bsplit-benefit-desc">{{ block.settings.description | escape }}</p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ISET Benefits Split",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "placeholder_icon",
      "label": "Placeholder icon (shown if no image)",
      "default": "🌿"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "image_placeholder_bg",
      "label": "Image placeholder background",
      "default": "#eef6d8"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label (optional)"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#4a6b1a"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Whole-Body Support, Rooted in Tradition"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1c2a0f"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "6 wildcrafted roots in every capsule."
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#5a7040"
    },
    {
      "type": "header",
      "content": "Benefit icons & text"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#4a6b1a"
    },
    {
      "type": "color",
      "id": "benefit_title_color",
      "label": "Benefit title color",
      "default": "#1c2a0f"
    },
    {
      "type": "color",
      "id": "benefit_desc_color",
      "label": "Benefit description color",
      "default": "#5a7040"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "energy", "label": "Energy (bolt)" },
            { "value": "strength", "label": "Strength (dumbbell)" },
            { "value": "shield", "label": "Shield" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "brain", "label": "Brain / focus" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Benefit description."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ISET Benefits Split",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
