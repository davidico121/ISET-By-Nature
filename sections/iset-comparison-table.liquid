{% comment %}
  ISET by Nature: "Us vs. Them" style comparison table (highlighted brand column + 2 generic comparison columns).
  Custom section with full schema controls.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .ip-cmp {
    background: {{ section.settings.background_color }};
    font-family: Inter, Arial, sans-serif;
  }
  #shopify-section-{{ section.id }} .ip-wrap {
    width: min(900px, calc(100% - 28px));
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .ip-head {
    max-width: 620px;
    margin: 0 auto 28px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .ip-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(24px, 3.6vw, 36px);
    line-height: 1.1;
    font-weight: 900;
    margin: 0;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .ip-sub {
    font-size: 15px;
    line-height: 1.6;
    color: {{ section.settings.subheading_color }};
    margin: 10px 0 0;
  }
  #shopify-section-{{ section.id }} .ip-cmp-table {
    position: relative;
    border: 1px solid {{ section.settings.border_color }};
    border-radius: 20px;
    overflow: hidden;
    background: {{ section.settings.table_background }};
    box-shadow: 0 14px 34px rgba(28,42,15,0.08);
  }
  #shopify-section-{{ section.id }} .ip-cmp-row {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr;
  }
  #shopify-section-{{ section.id }} .ip-cmp-row + .ip-cmp-row {
    border-top: 1px solid {{ section.settings.border_color }};
  }
  #shopify-section-{{ section.id }} .ip-cmp-cell {
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 14px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .ip-cmp-cell--label {
    align-items: flex-start;
    text-align: left;
  }
  #shopify-section-{{ section.id }} .ip-cmp-cell--label .ip-cmp-sub {
    font-weight: 500;
    font-size: 11px;
    color: {{ section.settings.subheading_color }};
    margin-top: 2px;
  }
  #shopify-section-{{ section.id }} .ip-cmp-cell--ours {
    background: {{ section.settings.our_column_bg }};
    color: {{ section.settings.our_column_text }};
    font-weight: 800;
  }
  #shopify-section-{{ section.id }} .ip-cmp-header .ip-cmp-cell--ours {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 18px;
  }
  #shopify-section-{{ section.id }} .ip-cmp-header .ip-cmp-cell {
    padding-top: 20px;
    padding-bottom: 20px;
  }
  @media screen and (max-width: 600px) {
    #shopify-section-{{ section.id }} .ip-cmp-row {
      grid-template-columns: 1fr 0.8fr 0.8fr 0.8fr;
    }
    #shopify-section-{{ section.id }} .ip-cmp-cell {
      padding: 12px 8px;
      font-size: 12px;
    }
    #shopify-section-{{ section.id }} .ip-cmp-header .ip-cmp-cell--ours {
      font-size: 13px;
    }
  }
</style>

<div class="ip-cmp">
  <div class="ip-wrap">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ip-head">
        {%- if section.settings.heading != blank -%}
          <h2 class="ip-title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ip-sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="ip-cmp-table">
      <div class="ip-cmp-row ip-cmp-header">
        <div class="ip-cmp-cell ip-cmp-cell--label"></div>
        <div class="ip-cmp-cell ip-cmp-cell--ours">{{ section.settings.our_column_label | escape }}</div>
        <div class="ip-cmp-cell">{{ section.settings.comp1_label | escape }}</div>
        <div class="ip-cmp-cell">{{ section.settings.comp2_label | escape }}</div>
      </div>
      {%- for block in section.blocks -%}
        <div class="ip-cmp-row" {{ block.shopify_attributes }}>
          <div class="ip-cmp-cell ip-cmp-cell--label">
            {{ block.settings.row_label | escape }}
          </div>
          <div class="ip-cmp-cell ip-cmp-cell--ours">{{ block.settings.our_value | escape }}</div>
          <div class="ip-cmp-cell">{{ block.settings.comp1_value | escape }}</div>
          <div class="ip-cmp-cell">{{ block.settings.comp2_value | escape }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ISET Comparison table",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Herbal Iron Capsules"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading / label color",
      "default": "#1c2a0f"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#5a7040"
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "text",
      "id": "our_column_label",
      "label": "Our column label",
      "default": "Herbal Iron Capsules"
    },
    {
      "type": "color",
      "id": "our_column_bg",
      "label": "Our column background",
      "default": "#1c2a0f"
    },
    {
      "type": "color",
      "id": "our_column_text",
      "label": "Our column text color",
      "default": "#8aab35"
    },
    {
      "type": "text",
      "id": "comp1_label",
      "label": "Comparison column 1 label",
      "default": "Generic Multivitamin"
    },
    {
      "type": "text",
      "id": "comp2_label",
      "label": "Comparison column 2 label",
      "default": "Synthetic Energy Pills"
    },
    {
      "type": "header",
      "content": "Table styling"
    },
    {
      "type": "color",
      "id": "table_background",
      "label": "Table background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider color",
      "default": "#4a6b1a2e"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color",
      "default": "#f7f3eb"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "row_label",
          "label": "Row label",
          "default": "Row label"
        },
        {
          "type": "text",
          "id": "our_value",
          "label": "Our value",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "comp1_value",
          "label": "Comparison 1 value",
          "default": "✗"
        },
        {
          "type": "text",
          "id": "comp2_value",
          "label": "Comparison 2 value",
          "default": "✗"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ISET Comparison table",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
