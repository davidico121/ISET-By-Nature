{% comment %}
  ISET by Nature: "Us vs. Them" comparison table, Sult-style (subtle highlighted column, green/gray badge circles).
  Custom section with full schema controls.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .ip-cmp {
    background: {{ section.settings.background_color }};
    font-family: var(--font-body-family);
  }
  #shopify-section-{{ section.id }} .ip-wrap {
    width: min(900px, calc(100% - 28px));
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .ip-head {
    max-width: 620px;
    margin: 0 auto 28px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .ip-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(24px, 3.6vw, 36px);
    line-height: 1.1;
    font-weight: 900;
    margin: 0;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .ip-sub {
    font-size: 16px;
    line-height: 1.6;
    color: {{ section.settings.subheading_color }};
    margin: 10px 0 0;
  }

  /* Mobile-first base: these sizes apply to small screens by default. */
  #shopify-section-{{ section.id }} .ip-cmp-table {
    position: relative;
    border: 1px solid {{ section.settings.border_color }};
    border-radius: 16px;
    background: {{ section.settings.table_background }};
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .ip-cmp-row {
    display: grid;
    grid-template-columns: 0.85fr 0.85fr 1.05fr 1.05fr;
  }
  #shopify-section-{{ section.id }} .ip-cmp-row:not(:last-child) {
    border-bottom: 1px solid {{ section.settings.border_color }};
  }

  #shopify-section-{{ section.id }} .ip-cmp-cell--ours {
    background: {{ section.settings.our_column_bg }};
  }

  #shopify-section-{{ section.id }} .ip-cmp-cell {
    min-height: 66px;
    padding: 12px 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 5px;
  }
  #shopify-section-{{ section.id }} .ip-cmp-cell--label {
    align-items: flex-start;
    text-align: left;
    padding-left: 16px;
  }
  #shopify-section-{{ section.id }} .ip-cmp-label-main {
    font-size: 14px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .ip-cmp-col-icon {
    width: 30px;
    height: 30px;
    object-fit: contain;
    margin-bottom: 4px;
  }
  #shopify-section-{{ section.id }} .ip-cmp-header .ip-cmp-cell {
    padding-top: 18px;
    padding-bottom: 16px;
  }
  #shopify-section-{{ section.id }} .ip-cmp-col-label {
    font-size: 12px;
    font-weight: 700;
    line-height: 1.25;
    color: {{ section.settings.heading_color }};
    overflow-wrap: break-word;
    hyphens: auto;
  }
  #shopify-section-{{ section.id }} .ip-cmp-header .ip-cmp-cell--ours .ip-cmp-col-label {
    font-weight: 800;
  }
  #shopify-section-{{ section.id }} .ip-cmp-our-pick {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    background: {{ section.settings.badge_bg_color }};
    color: {{ section.settings.badge_text_color }};
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 999px;
    margin-bottom: 6px;
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .ip-cmp-header .ip-cmp-cell:not(.ip-cmp-cell--ours):not(.ip-cmp-cell--label) .ip-cmp-col-label {
    color: {{ section.settings.subheading_color }};
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .ip-cmp-value {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .ip-cmp-badge {
    width: 25px;
    height: 25px;
    min-width: 25px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 900;
  }
  #shopify-section-{{ section.id }} .ip-cmp-badge--check {
    background: {{ section.settings.check_badge_color }};
    color: #000000;
  }
  #shopify-section-{{ section.id }} .ip-cmp-badge--x {
    background: {{ section.settings.x_badge_color }};
    color: {{ section.settings.x_badge_icon_color }};
  }
  #shopify-section-{{ section.id }} .ip-cmp-badge--spacer {
    background: transparent;
    visibility: hidden;
  }

  /* Desktop / larger screens: scale everything up for legibility. */
  @media screen and (min-width: 601px) {
    #shopify-section-{{ section.id }} .ip-cmp-row {
      grid-template-columns: 1.2fr 1fr 1fr 1fr;
    }
    #shopify-section-{{ section.id }} .ip-cmp-cell {
      min-height: 76px;
      padding: 18px 14px;
      gap: 6px;
    }
    #shopify-section-{{ section.id }} .ip-cmp-cell--label {
      padding-left: 24px;
    }
    #shopify-section-{{ section.id }} .ip-cmp-label-main {
      font-size: 18px;
    }
    #shopify-section-{{ section.id }} .ip-cmp-col-icon {
      width: 36px;
      height: 36px;
    }
    #shopify-section-{{ section.id }} .ip-cmp-header .ip-cmp-cell {
      padding-top: 26px;
      padding-bottom: 22px;
    }
    #shopify-section-{{ section.id }} .ip-cmp-col-label {
      font-size: 17px;
      line-height: 1.3;
    }
    #shopify-section-{{ section.id }} .ip-cmp-value {
      font-size: 18px;
    }
    #shopify-section-{{ section.id }} .ip-cmp-badge {
      width: 30px;
      height: 30px;
      min-width: 30px;
      font-size: 15px;
    }
  }
</style>

<div class="ip-cmp">
  <div class="ip-wrap">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ip-head">
        {%- if section.settings.heading != blank -%}
          <h2 class="ip-title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ip-sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="ip-cmp-table">
      <div class="ip-cmp-row ip-cmp-header">
        <div class="ip-cmp-cell ip-cmp-cell--label"></div>
        <div class="ip-cmp-cell ip-cmp-cell--ours">
          {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
            <span class="ip-cmp-our-pick">&#9733; {{ section.settings.badge_text | escape }}</span>
          {%- endif -%}
          {%- if section.settings.our_column_image != blank -%}
            {{ section.settings.our_column_image | image_url: width: 240 | image_tag: class: 'ip-cmp-col-icon', loading: 'lazy' }}
          {%- endif -%}
          <span class="ip-cmp-col-label">{{ section.settings.our_column_label | escape }}</span>
        </div>
        <div class="ip-cmp-cell">
          {%- if section.settings.comp1_image != blank -%}
            {{ section.settings.comp1_image | image_url: width: 240 | image_tag: class: 'ip-cmp-col-icon', loading: 'lazy' }}
          {%- endif -%}
          <span class="ip-cmp-col-label">{{ section.settings.comp1_label | escape }}</span>
        </div>
        <div class="ip-cmp-cell">
          {%- if section.settings.comp2_image != blank -%}
            {{ section.settings.comp2_image | image_url: width: 240 | image_tag: class: 'ip-cmp-col-icon', loading: 'lazy' }}
          {%- endif -%}
          <span class="ip-cmp-col-label">{{ section.settings.comp2_label | escape }}</span>
        </div>
      </div>
      {%- for block in section.blocks -%}
        <div class="ip-cmp-row" {{ block.shopify_attributes }}>
          <div class="ip-cmp-cell ip-cmp-cell--label">
            <span class="ip-cmp-label-main">{{ block.settings.row_label | escape }}</span>
          </div>

          <div class="ip-cmp-cell ip-cmp-cell--ours">
            {%- if block.settings.our_icon == 'check' -%}
              <span class="ip-cmp-badge ip-cmp-badge--check">&#10003;</span>
            {%- else -%}
              <span class="ip-cmp-badge ip-cmp-badge--spacer" aria-hidden="true"></span>
            {%- endif -%}
            {%- if block.settings.our_value != blank -%}
              <span class="ip-cmp-value">{{ block.settings.our_value | escape }}</span>
            {%- endif -%}
          </div>

          <div class="ip-cmp-cell">
            {%- if block.settings.comp1_icon == 'check' -%}
              <span class="ip-cmp-badge ip-cmp-badge--check">&#10003;</span>
            {%- elsif block.settings.comp1_icon == 'x' -%}
              <span class="ip-cmp-badge ip-cmp-badge--x">&#10005;</span>
            {%- else -%}
              <span class="ip-cmp-badge ip-cmp-badge--spacer" aria-hidden="true"></span>
            {%- endif -%}
            {%- if block.settings.comp1_value != blank -%}
              <span class="ip-cmp-value">{{ block.settings.comp1_value | escape }}</span>
            {%- endif -%}
          </div>

          <div class="ip-cmp-cell">
            {%- if block.settings.comp2_icon == 'check' -%}
              <span class="ip-cmp-badge ip-cmp-badge--check">&#10003;</span>
            {%- elsif block.settings.comp2_icon == 'x' -%}
              <span class="ip-cmp-badge ip-cmp-badge--x">&#10005;</span>
            {%- else -%}
              <span class="ip-cmp-badge ip-cmp-badge--spacer" aria-hidden="true"></span>
            {%- endif -%}
            {%- if block.settings.comp2_value != blank -%}
              <span class="ip-cmp-value">{{ block.settings.comp2_value | escape }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ISET Comparison table",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Herbal Iron Capsules"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading / label color",
      "default": "#1c2a0f"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading / muted text color",
      "default": "#5a7040"
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "text",
      "id": "our_column_label",
      "label": "Our column label",
      "default": "HERBAL IRON"
    },
    {
      "type": "image_picker",
      "id": "our_column_image",
      "label": "Our column icon (optional)"
    },
    {
      "type": "color",
      "id": "our_column_bg",
      "label": "Our column background",
      "default": "#eef4e6"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show \"Our Pick\" badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Our Pick"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge background",
      "default": "#4a6b1a"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text color",
      "default": "#f5f0e8"
    },
    {
      "type": "text",
      "id": "comp1_label",
      "label": "Comparison column 1 label",
      "default": "Generic Multivitamin"
    },
    {
      "type": "image_picker",
      "id": "comp1_image",
      "label": "Comparison column 1 icon (optional)"
    },
    {
      "type": "text",
      "id": "comp2_label",
      "label": "Comparison column 2 label",
      "default": "Synthetic Energy Pills"
    },
    {
      "type": "image_picker",
      "id": "comp2_image",
      "label": "Comparison column 2 icon (optional)"
    },
    {
      "type": "header",
      "content": "Badges"
    },
    {
      "type": "color",
      "id": "check_badge_color",
      "label": "Checkmark badge background",
      "default": "#a3d23c"
    },
    {
      "type": "color",
      "id": "x_badge_color",
      "label": "X badge background",
      "default": "#e3e3e0"
    },
    {
      "type": "color",
      "id": "x_badge_icon_color",
      "label": "X badge icon color",
      "default": "#9a9a95"
    },
    {
      "type": "header",
      "content": "Table styling"
    },
    {
      "type": "color",
      "id": "table_background",
      "label": "Table background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider color",
      "default": "#ececea"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color",
      "default": "#f7f3eb"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "row_label",
          "label": "Row label",
          "default": "Row label"
        },
        {
          "type": "header",
          "content": "Our column"
        },
        {
          "type": "select",
          "id": "our_icon",
          "label": "Show checkmark",
          "options": [
            { "value": "none", "label": "No icon" },
            { "value": "check", "label": "Checkmark" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "our_value",
          "label": "Our value",
          "info": "Leave blank to show just the checkmark."
        },
        {
          "type": "header",
          "content": "Comparison column 1"
        },
        {
          "type": "select",
          "id": "comp1_icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "No icon" },
            { "value": "check", "label": "Checkmark" },
            { "value": "x", "label": "X mark" }
          ],
          "default": "x"
        },
        {
          "type": "text",
          "id": "comp1_value",
          "label": "Value (text, optional)"
        },
        {
          "type": "header",
          "content": "Comparison column 2"
        },
        {
          "type": "select",
          "id": "comp2_icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "No icon" },
            { "value": "check", "label": "Checkmark" },
            { "value": "x", "label": "X mark" }
          ],
          "default": "x"
        },
        {
          "type": "text",
          "id": "comp2_value",
          "label": "Value (text, optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ISET Comparison table",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
