{% comment %}
  ISET by Nature: "Us vs. Them" style comparison table (highlighted brand column + 2 generic comparison columns).
  Custom section with full schema controls.
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .ip-cmp {
    background: {{ section.settings.background_color }};
    font-family: Inter, Arial, sans-serif;
  }
  #shopify-section-{{ section.id }} .ip-wrap {
    width: min(900px, calc(100% - 28px));
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .ip-head {
    max-width: 620px;
    margin: 0 auto 28px;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .ip-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(24px, 3.6vw, 36px);
    line-height: 1.1;
    font-weight: 900;
    margin: 0;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .ip-sub {
    font-size: 15px;
    line-height: 1.6;
    color: {{ section.settings.subheading_color }};
    margin: 10px 0 0;
  }

  #shopify-section-{{ section.id }} .ip-cmp-table {
    position: relative;
    border: 1px solid {{ section.settings.border_color }};
    border-radius: 20px;
    background: {{ section.settings.table_background }};
    box-shadow: 0 14px 34px rgba(28,42,15,0.08);
    padding: 0 14px;
  }
  #shopify-section-{{ section.id }} .ip-cmp-row {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr;
    position: relative;
  }
  #shopify-section-{{ section.id }} .ip-cmp-row:not(:last-child) .ip-cmp-cell:not(.ip-cmp-cell--ours) {
    border-bottom: 1px solid {{ section.settings.border_color }};
  }

  /* The floating "ours" card: overlaps the table top/bottom and sits above the row dividers */
  #shopify-section-{{ section.id }} .ip-cmp-cell--ours {
    background: {{ section.settings.our_column_bg }};
    color: {{ section.settings.our_column_text }};
    border: 2px solid {{ section.settings.heading_color }};
    border-left: none;
    border-right: none;
    position: relative;
    z-index: 2;
  }
  #shopify-section-{{ section.id }} .ip-cmp-row.ip-cmp-header .ip-cmp-cell--ours {
    border-top: 2px solid {{ section.settings.heading_color }};
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    margin-top: -1px;
  }
  #shopify-section-{{ section.id }} .ip-cmp-row:last-child .ip-cmp-cell--ours {
    border-bottom: 2px solid {{ section.settings.heading_color }};
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    margin-bottom: -1px;
  }
  #shopify-section-{{ section.id }} .ip-cmp-cell--ours + .ip-cmp-row .ip-cmp-cell--ours {
    border-top: none;
  }

  #shopify-section-{{ section.id }} .ip-cmp-cell {
    padding: 18px 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 4px;
  }
  #shopify-section-{{ section.id }} .ip-cmp-cell--label {
    align-items: flex-start;
    text-align: left;
  }
  #shopify-section-{{ section.id }} .ip-cmp-label-main {
    font-size: 14px;
    font-weight: 800;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .ip-cmp-label-sub {
    font-weight: 500;
    font-size: 11px;
    color: {{ section.settings.subheading_color }};
  }

  #shopify-section-{{ section.id }} .ip-cmp-row.ip-cmp-header .ip-cmp-cell--ours {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 22px;
    font-weight: 900;
    padding-top: 22px;
    padding-bottom: 22px;
  }
  #shopify-section-{{ section.id }} .ip-cmp-row.ip-cmp-header .ip-cmp-cell:not(.ip-cmp-cell--ours):not(.ip-cmp-cell--label) {
    font-size: 13px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    padding-top: 22px;
    padding-bottom: 22px;
  }

  #shopify-section-{{ section.id }} .ip-cmp-value-large {
    font-size: 20px;
    font-weight: 900;
  }

  #shopify-section-{{ section.id }} .ip-cmp-badge {
    width: 28px;
    height: 28px;
    min-width: 28px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 900;
    background: {{ section.settings.heading_color }};
    color: {{ section.settings.table_background }};
  }
  #shopify-section-{{ section.id }} .ip-cmp-badge--x {
    background: {{ section.settings.heading_color }};
  }

  @media screen and (max-width: 600px) {
    #shopify-section-{{ section.id }} .ip-cmp-row {
      grid-template-columns: 1fr 0.8fr 0.8fr 0.8fr;
    }
    #shopify-section-{{ section.id }} .ip-cmp-cell {
      padding: 12px 6px;
    }
    #shopify-section-{{ section.id }} .ip-cmp-label-main {
      font-size: 12px;
    }
    #shopify-section-{{ section.id }} .ip-cmp-row.ip-cmp-header .ip-cmp-cell--ours {
      font-size: 15px;
    }
    #shopify-section-{{ section.id }} .ip-cmp-value-large {
      font-size: 15px;
    }
    #shopify-section-{{ section.id }} .ip-cmp-badge {
      width: 22px;
      height: 22px;
      min-width: 22px;
      font-size: 12px;
    }
  }
</style>

<div class="ip-cmp">
  <div class="ip-wrap">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="ip-head">
        {%- if section.settings.heading != blank -%}
          <h2 class="ip-title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="ip-sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="ip-cmp-table">
      <div class="ip-cmp-row ip-cmp-header">
        <div class="ip-cmp-cell ip-cmp-cell--label"></div>
        <div class="ip-cmp-cell ip-cmp-cell--ours">{{ section.settings.our_column_label | escape }}</div>
        <div class="ip-cmp-cell">{{ section.settings.comp1_label | escape }}</div>
        <div class="ip-cmp-cell">{{ section.settings.comp2_label | escape }}</div>
      </div>
      {%- for block in section.blocks -%}
        <div class="ip-cmp-row" {{ block.shopify_attributes }}>
          <div class="ip-cmp-cell ip-cmp-cell--label">
            <span class="ip-cmp-label-main">{{ block.settings.row_label | escape }}</span>
            {%- if block.settings.row_sublabel != blank -%}
              <span class="ip-cmp-label-sub">{{ block.settings.row_sublabel | escape }}</span>
            {%- endif -%}
          </div>

          <div class="ip-cmp-cell ip-cmp-cell--ours">
            {%- if block.settings.our_icon == 'check' -%}
              <span class="ip-cmp-value-large">&#10003;</span>
            {%- endif -%}
            {%- if block.settings.our_value != blank -%}
              <span class="ip-cmp-value-large">{{ block.settings.our_value | escape }}</span>
            {%- endif -%}
          </div>

          <div class="ip-cmp-cell">
            {%- if block.settings.comp1_icon == 'check' -%}
              <span class="ip-cmp-badge">&#10003;</span>
            {%- elsif block.settings.comp1_icon == 'x' -%}
              <span class="ip-cmp-badge ip-cmp-badge--x">&#10005;</span>
            {%- endif -%}
            {%- if block.settings.comp1_value != blank -%}
              <span>{{ block.settings.comp1_value | escape }}</span>
            {%- endif -%}
          </div>

          <div class="ip-cmp-cell">
            {%- if block.settings.comp2_icon == 'check' -%}
              <span class="ip-cmp-badge">&#10003;</span>
            {%- elsif block.settings.comp2_icon == 'x' -%}
              <span class="ip-cmp-badge ip-cmp-badge--x">&#10005;</span>
            {%- endif -%}
            {%- if block.settings.comp2_value != blank -%}
              <span>{{ block.settings.comp2_value | escape }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ISET Comparison table",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Herbal Iron Capsules"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading / label / border color",
      "default": "#1c2a0f"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading / caption color",
      "default": "#5a7040"
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "text",
      "id": "our_column_label",
      "label": "Our column label",
      "default": "Herbal Iron Capsules"
    },
    {
      "type": "color",
      "id": "our_column_bg",
      "label": "Our column background",
      "default": "#8aab35"
    },
    {
      "type": "color",
      "id": "our_column_text",
      "label": "Our column text color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "comp1_label",
      "label": "Comparison column 1 label",
      "default": "Generic Multivitamin"
    },
    {
      "type": "text",
      "id": "comp2_label",
      "label": "Comparison column 2 label",
      "default": "Synthetic Energy Pills"
    },
    {
      "type": "header",
      "content": "Table styling"
    },
    {
      "type": "color",
      "id": "table_background",
      "label": "Table background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Row divider color",
      "default": "#4a6b1a2e"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color",
      "default": "#f7f3eb"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "row_label",
          "label": "Row label",
          "default": "Row label"
        },
        {
          "type": "text",
          "id": "row_sublabel",
          "label": "Row sublabel (optional caption)"
        },
        {
          "type": "header",
          "content": "Our column"
        },
        {
          "type": "select",
          "id": "our_icon",
          "label": "Show checkmark",
          "options": [
            { "value": "none", "label": "No icon" },
            { "value": "check", "label": "Checkmark" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "our_value",
          "label": "Our value",
          "info": "Shown large and bold. Leave blank to show just the checkmark."
        },
        {
          "type": "header",
          "content": "Comparison column 1"
        },
        {
          "type": "select",
          "id": "comp1_icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "No icon" },
            { "value": "check", "label": "Checkmark" },
            { "value": "x", "label": "X mark" }
          ],
          "default": "x"
        },
        {
          "type": "text",
          "id": "comp1_value",
          "label": "Value (text, optional)"
        },
        {
          "type": "header",
          "content": "Comparison column 2"
        },
        {
          "type": "select",
          "id": "comp2_icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "No icon" },
            { "value": "check", "label": "Checkmark" },
            { "value": "x", "label": "X mark" }
          ],
          "default": "x"
        },
        {
          "type": "text",
          "id": "comp2_value",
          "label": "Value (text, optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ISET Comparison table",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
