    "custom_liquid_93nGgP": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "visibility": "always-display",
        "custom_liquid": "{% comment %}\n  ISET by Nature: Herbal Iron Product Page\n  File: sections/iset-herbal-iron-pdp.liquid\n  CRO-focused, high-converting product description section\n{% endcomment %}\n\n{% assign hi_urgency = 'Wildcrafted in Jamaica · 100% Real Roots · Nothing Artificial. Ever.' %}\n{% assign hi_reviews_label = 'Verified customer results' %}\n{% assign hi_hero_eyebrow = 'Energy & Vitality' %}\n{% assign hi_hero_title = '8 Jamaican roots. One tonic. Real strength.' %}\n{% assign hi_hero_text = 'Herbal Iron is a potent daily blend of 8 wildcrafted Jamaican roots, traditionally brewed for natural energy, stamina and whole-body vitality. No caffeine. No fillers. No shortcuts. Just the tonic Caribbean men have trusted for generations.' %}\n\n{% assign hi_r1 = 'I have been taking this every morning for 6 weeks. My energy is completely different. I do not reach for coffee anymore.' %}\n{% assign hi_r1_name = 'Verified buyer · Delroy M., Brooklyn NY' %}\n{% assign hi_r2 = 'My grandfather used to make this in Jamaica. This is exactly what it tasted like. The real deal. Nothing else like it.' %}\n{% assign hi_r2_name = 'Verified buyer · Marcus T., Toronto CA' %}\n{% assign hi_r3 = 'Started drinking this as my morning ritual. After two weeks I noticed my stamina at the gym was different. This is the real thing.' %}\n{% assign hi_r3_name = 'Verified buyer · Jerome K., Atlanta GA' %}\n\n{% assign hi_proof_1_n = '8' %}\n{% assign hi_proof_1_t = 'Wildcrafted Jamaican roots in every single batch.' %}\n{% assign hi_proof_2_n = '0' %}\n{% assign hi_proof_2_t = 'Caffeine or synthetic stimulants. Ever.' %}\n{% assign hi_proof_3_n = '30' %}\n{% assign hi_proof_3_t = 'Daily servings to build a consistent ritual.' %}\n\n{% assign hi_proof_4_n = '100%' %}\n{% assign hi_proof_4_t = 'Wildcrafted from Jamaican hillsides and coastlines.' %}\n\n{% assign hi_benefits_ey = 'Why it works' %}\n{% assign hi_benefits_title = 'Rooted in tradition, not a lab.' %}\n{% assign hi_benefits_text = 'Most supplements are formulated in a lab. This one is a recipe: passed down, not invented.' %}\n{% assign hi_b1_title = 'Grown wild, not farmed' %}\n{% assign hi_b1_text = 'Our roots aren’t cultivated. They’re found, the way Jamaican herbalists have always sourced them.' %}\n{% assign hi_b2_title = '8 roots, one blend' %}\n{% assign hi_b2_text = 'Sarsaparilla, Chaney, Strongback, and more: each one chosen for a reason, not filler.' %}\n{% assign hi_b3_title = 'Brewed, not blended' %}\n{% assign hi_b3_text = 'Simmered the traditional way, straight from the root.' %}\n{% assign hi_b4_title = 'Nothing added' %}\n{% assign hi_b4_text = 'No fillers. No binders. No synthetic ingredients. What is in the bag is what is on the label, and nothing else.' %}\n\n{% assign hi_ritual_ey = 'The morning ritual' %}\n{% assign hi_ritual_title = 'What happens when you drink it.' %}\n{% assign hi_ritual_text = 'This is not a supplement you swallow and forget. It is a ritual: the same one Jamaican families have kept for generations.' %}\n{% assign hi_rit_1_title = 'You brew it' %}\n{% assign hi_rit_1_text = 'Two cups of water. One heaping tablespoon. Simmer for 20 minutes until it reduces. The smell alone tells you something real is happening.' %}\n{% assign hi_rit_2_title = 'You drink it' %}\n{% assign hi_rit_2_text = 'Every morning on an empty stomach. Warm, earthy, deep: the way it’s always been made.' %}\n{% assign hi_rit_3_title = 'You feel it' %}\n{% assign hi_rit_3_text = 'Not a jolt. Not a crash. Just steady, natural energy that settles in over time.' %}\n\n{% assign hi_how_ey = 'How to make your tonic' %}\n{% assign hi_how_title = 'Brew. Strain. Drink. Repeat.' %}\n{% assign hi_how_text = 'Follow the directions on the package, or the way grandmothers have always done it.' %}\n{% assign hi_s1_title = 'Boil your water' %}\n{% assign hi_s1_text = 'Bring 2 cups of water to a boil in a small pot.' %}\n{% assign hi_s2_title = 'Add and simmer' %}\n{% assign hi_s2_text = 'Add 1 heaping tablespoon of Herbal Iron. Cover, reduce heat and simmer 20 minutes until liquid reduces by half.' %}\n{% assign hi_s3_title = 'Strain and drink' %}\n{% assign hi_s3_text = 'Strain and enjoy warm as a tea, or bottle and refrigerate as a daily tonic. Drink every morning on an empty stomach.' %}\n{% assign hi_s4_title = 'Pro tip' %}\n{% assign hi_s4_text = 'Make a large batch and refrigerate up to 5 days. Add honey or lemon to taste. Consistency is everything: drink daily for best experience.' %}\n\n{% assign hi_timeline_title = 'A simple daily wellness routine.' %}\n{% assign hi_tl_1_badge = 'Morning' %}\n{% assign hi_tl_1_text = 'Brew it fresh, or pour from your fridge batch. Drink on an empty stomach, before breakfast.' %}\n{% assign hi_tl_2_badge = 'Daily' %}\n{% assign hi_tl_2_text = 'One heaping tablespoon per serving. Measure it the same way, every time.' %}\n{% assign hi_tl_3_badge = 'Weekly' %}\n{% assign hi_tl_3_text = 'A batch lasts about 5 days in the fridge. Brew again when it runs low.' %}\n\n{% assign hi_ing_ey = 'What is inside' %}\n{% assign hi_ing_title = 'Every root earns its place.' %}\n{% assign hi_ing_text = 'Eight wildcrafted Jamaican roots: each one chosen for a reason, each one harvested by hand from Jamaican soil.' %}\n{% assign hi_i1_name = 'Sarsaparilla Root' %}\n{% assign hi_i1_sci = 'Smilax regelii' %}\n{% assign hi_i1_text = 'Traditionally used for blood purification and energy support. A cornerstone of Jamaican root tonic culture.' %}\n{% assign hi_i2_name = 'Chaney Root' %}\n{% assign hi_i2_sci = 'Smilax balbisiana' %}\n{% assign hi_i2_text = 'One of Jamaica most revered roots. Used for generations to support male vitality and whole-body strength.' %}\n{% assign hi_i3_name = 'Strongback' %}\n{% assign hi_i3_sci = 'Morinda royoc' %}\n{% assign hi_i3_text = 'The name says it all. Traditionally brewed for back strength, endurance and stamina, a Jamaican staple.' %}\n{% assign hi_i4_name = 'Blue Vervain Root' %}\n{% assign hi_i4_sci = 'Stachytarpheta jamaicensis' %}\n{% assign hi_i4_text = 'A powerful Jamaican herb used to support the nervous system and promote calm, focused energy.' %}\n\n{% assign hi_guarantee_title = 'Feel the difference — with consistent use.' %}\n{% assign hi_guarantee_text = 'Real roots don’t work like a stimulant. Take Herbal Iron daily, the way it’s traditionally made: a tonic, not a shortcut. Results vary from person to person.' %}\n\n{% assign hi_faq_ey = 'FAQ' %}\n{% assign hi_faq_title = 'Your questions, answered' %}\n{% assign hi_faq_1_q = 'Are all 8 roots really wildcrafted from Jamaica?' %}\n{% assign hi_faq_1_a = 'Yes. Every root we use is wildcrafted and sourced from Jamaica. We work with Jamaican harvesters to ensure authenticity at the source.' %}\n{% assign hi_faq_2_q = 'How long until I feel a difference?' %}\n{% assign hi_faq_2_a = 'Results vary from person to person. Many customers make it a daily habit: the ritual is the point.' %}\n{% assign hi_faq_3_q = 'Can women take Herbal Iron too?' %}\n{% assign hi_faq_3_a = 'Absolutely. These roots support energy and vitality for everyone. If pregnant or breastfeeding, consult your healthcare provider first.' %}\n{% assign hi_faq_4_q = 'Is there caffeine or synthetic stimulants in this?' %}\n{% assign hi_faq_4_a = 'None. Zero caffeine, zero synthetic stimulants. Just wildcrafted roots.' %}\n{% assign hi_faq_5_q = 'How do I make the tonic?' %}\n{% assign hi_faq_5_a = 'Bring 2 cups of water to a boil. Add 1 heaping tablespoon of Herbal Iron. Cover, reduce heat and simmer for 20 minutes until the liquid reduces by half. Strain and drink warm — or bottle and refrigerate as a daily tonic.' %}\n{% assign hi_faq_6_q = 'How long will one pack of Herbal Iron last?' %}\n{% assign hi_faq_6_a = 'One pack provides approximately 30 servings and should last about 1 month when taken at the recommended daily serving. Your actual usage may vary slightly depending on how you measure each serving' %}\n{% assign hi_faq_7_q = 'Is this a medicine?' %}\n{% assign hi_faq_7_a = 'No. Herbal Iron is a food-based herbal product. It is not intended to diagnose, treat, cure, or prevent any disease.' %}\n\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap');\n\n  .iset-pdp {\n    --ip-bg: #f7f3eb;\n    --ip-bg-soft: #eef6d8;\n    --ip-bg-dark: #1c2a0f;\n    --ip-card: #ffffff;\n    --ip-text: #1c2a0f;\n    --ip-muted: #5a7040;\n    --ip-accent: #8aab35;\n    --ip-accent-dark: #4a6b1a;\n    --ip-border: rgba(74,107,26,0.18);\n    --ip-shadow: 0 14px 34px rgba(28,42,15,0.08);\n    font-family: Inter, Arial, sans-serif;\n    color: var(--ip-text);\n    background: var(--ip-bg);\n    overflow: hidden;\n  }\n  .iset-pdp * { box-sizing: border-box; }\n  .ip-wrap { width: min(1100px, calc(100% - 28px)); margin: 0 auto; }\n  .ip-section { padding: 52px 0; }\n  .ip-head { max-width: 740px; margin: 0 auto 28px; text-align: center; }\n  .ip-eyebrow { color: var(--ip-accent-dark); font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 10px; }\n  .ip-title { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(26px, 4vw, 48px); line-height: 1.06; font-weight: 900; margin: 0; color: var(--ip-text); }\n  .ip-title-light { color: #f5f0e8; }\n  .ip-text { color: var(--ip-muted); font-size: 15px; line-height: 1.65; margin: 12px 0 0; }\n  .ip-text-light { color: rgba(255,255,255,0.65); }\n\n  /* Urgency */\n  .ip-urgency { background: var(--ip-bg-dark); color: #f5f0e8; text-align: center; font-size: 13px; font-weight: 700; letter-spacing: .04em; padding: 11px 16px; }\n  .ip-urgency span { color: var(--ip-accent); margin: 0 6px; }\n\n  /* Hero proof */\n  .ip-hero { background: linear-gradient(135deg, #f7f3eb 0%, #eef4db 100%); border-bottom: 1px solid var(--ip-border); }\n  .ip-pill { display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: 999px; background: rgba(255,255,255,0.85); border: 1px solid var(--ip-border); font-size: 12px; font-weight: 800; color: var(--ip-text); margin-bottom: 14px; }\n  .ip-results { display: flex; gap: 18px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px 0 12px; -webkit-overflow-scrolling: touch; }\n  .ip-results::-webkit-scrollbar { height: 5px; }\n  .ip-results::-webkit-scrollbar-thumb { background: rgba(74,107,26,0.25); border-radius: 999px; }\n  .ip-result-card { flex: 0 0 calc(33.333% - 13px); min-width: 270px; scroll-snap-align: center; background: #fff; border: 1px solid var(--ip-border); border-radius: 24px; overflow: hidden; box-shadow: var(--ip-shadow); }\n  .ip-result-body { padding: 16px; }\n  .ip-stars { color: var(--ip-accent); font-size: 12px; letter-spacing: .06em; margin-bottom: 8px; }\n  .ip-result-body p { font-size: 13.5px; line-height: 1.5; margin: 0 0 10px; font-style: italic; font-family: 'Playfair Display', Georgia, serif; color: var(--ip-text); }\n  .ip-result-body strong { font-size: 11px; color: var(--ip-muted); font-weight: 700; }\n\n  /* Proof bar */\n  .ip-proof-bar { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; margin-top: 24px; }\n  .ip-proof-item { background: rgba(255,255,255,0.8); border: 1px solid var(--ip-border); border-radius: 16px; padding: 16px 12px; text-align: center; }\n  .ip-proof-item strong { display: block; font-family: 'Playfair Display', Georgia, serif; font-size: 28px; font-weight: 900; color: var(--ip-accent-dark); margin-bottom: 5px; }\n  .ip-proof-item span { color: var(--ip-muted); font-size: 12px; line-height: 1.35; }\n\n  /* Trust strip */\n  .ip-trust-strip { background: var(--ip-bg-dark); padding: 18px 0; border-top: 1px solid rgba(138,171,53,0.2); border-bottom: 1px solid rgba(138,171,53,0.2); }\n  .ip-trust-inner { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }\n  .ip-trust-badge { display: flex; align-items: center; gap: 7px; background: rgba(255,255,255,0.06); border: 1px solid rgba(138,171,53,0.25); border-radius: 999px; padding: 8px 14px; font-size: 12px; font-weight: 700; color: #f5f0e8; white-space: nowrap; }\n  .ip-trust-badge span:first-child { font-size: 15px; }\n\n  /* Benefits */\n  .ip-benefits-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; margin-top: 24px; }\n  .ip-benefit { background: #fff; border: 1px solid var(--ip-border); border-radius: 20px; padding: 20px 16px; box-shadow: var(--ip-shadow); }\n  .ip-benefit-icon { font-size: 24px; margin-bottom: 10px; }\n  .ip-benefit strong { display: block; font-family: 'Playfair Display', Georgia, serif; font-size: 15px; line-height: 1.25; font-weight: 700; margin-bottom: 7px; color: var(--ip-text); }\n  .ip-benefit span { display: block; color: var(--ip-muted); font-size: 13px; line-height: 1.5; }\n\n  /* Ritual, dark */\n  .ip-ritual { background: var(--ip-bg-dark); }\n  .ip-ritual-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; margin-top: 28px; }\n  .ip-ritual-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(138,171,53,0.15); border-radius: 20px; padding: 24px 20px; }\n  .ip-ritual-num { font-family: 'Playfair Display', Georgia, serif; font-size: 42px; font-weight: 900; color: var(--ip-accent); line-height: 1; margin-bottom: 12px; }\n  .ip-ritual-card h3 { font-family: 'Playfair Display', Georgia, serif; font-size: 18px; font-weight: 700; color: #f5f0e8; margin: 0 0 8px; }\n  .ip-ritual-card p { color: rgba(255,255,255,0.6); font-size: 13.5px; line-height: 1.6; margin: 0; }\n  .ip-ritual .ip-eyebrow { color: var(--ip-accent); }\n\n  /* How to, lifestyle split */\n  .ip-lifestyle { background: var(--ip-bg-soft); border-top: 1px solid var(--ip-border); border-bottom: 1px solid var(--ip-border); }\n  .ip-lifestyle-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; align-items: center; }\n  .ip-lifestyle-media { border-radius: 24px; overflow: hidden; border: 1px solid var(--ip-border); box-shadow: var(--ip-shadow); aspect-ratio: 1/1; background: var(--ip-bg); display:flex; align-items:center; justify-content:center; font-size:60px; }\n  .ip-lifestyle-media img { width:100%; height:100%; object-fit:cover; display:block; }\n  .ip-lifestyle-copy h2 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(24px, 3.4vw, 40px); line-height: 1.1; font-weight: 900; margin: 0 0 10px; color: var(--ip-text); }\n  .ip-lifestyle-copy p { color: var(--ip-muted); font-size: 14px; line-height: 1.65; margin: 0 0 16px; }\n  .ip-steps { display: grid; gap: 10px; }\n  .ip-step { display: grid; grid-template-columns: 36px 1fr; gap: 12px; align-items: start; background: rgba(255,255,255,0.75); border: 1px solid var(--ip-border); border-radius: 16px; padding: 12px 14px; }\n  .ip-step-num { width: 36px; height: 36px; border-radius: 10px; background: var(--ip-bg-dark); color: var(--ip-accent); display: grid; place-items: center; font-size: 13px; font-weight: 900; font-family: 'Playfair Display', Georgia, serif; }\n  .ip-step strong { display: block; font-size: 13px; font-weight: 800; margin-bottom: 2px; color: var(--ip-text); }\n  .ip-step span { display: block; color: var(--ip-muted); font-size: 12.5px; line-height: 1.45; }\n\n  /* Timeline */\n  .ip-timeline-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; margin-top: 28px; }\n  .ip-timeline-card { background: #fff; border: 1px solid var(--ip-border); border-radius: 20px; padding: 22px 18px; box-shadow: 0 10px 24px rgba(28,42,15,0.05); }\n  .ip-timeline-badge { display: inline-flex; padding: 5px 12px; border-radius: 999px; background: var(--ip-bg-dark); color: var(--ip-accent); font-size: 11px; font-weight: 800; letter-spacing: .04em; margin-bottom: 12px; }\n  .ip-timeline-card h3 { font-family: 'Playfair Display', Georgia, serif; font-size: 17px; font-weight: 700; margin: 0 0 8px; color: var(--ip-text); }\n  .ip-timeline-card p { color: var(--ip-muted); font-size: 13px; line-height: 1.55; margin: 0; }\n\n  /* Ingredients */\n  .ip-ing-section { background: var(--ip-bg); border-top: 1px solid var(--ip-border); }\n  .ip-ingredients-row { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px 0 10px; -webkit-overflow-scrolling: touch; }\n  .ip-ingredients-row::-webkit-scrollbar { height: 5px; }\n  .ip-ingredients-row::-webkit-scrollbar-thumb { background: rgba(74,107,26,0.25); border-radius: 999px; }\n  .ip-ingredient { flex: 0 0 calc(25% - 12px); min-width: 200px; scroll-snap-align: center; background: #fff; border: 1px solid var(--ip-border); border-radius: 20px; padding: 20px 16px; box-shadow: var(--ip-shadow); }\n  .ip-ing-icon { font-size: 28px; margin-bottom: 10px; }\n  .ip-ingredient h3 { font-family: 'Playfair Display', Georgia, serif; font-size: 15px; font-weight: 700; margin: 0 0 3px; color: var(--ip-text); }\n  .ip-ingredient em { display: block; font-size: 11px; color: var(--ip-accent-dark); font-style: italic; margin-bottom: 8px; }\n  .ip-ingredient p { color: var(--ip-muted); font-size: 12.5px; line-height: 1.5; margin: 0; }\n  .ip-ing-pills { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 20px; justify-content: center; }\n  .ip-ing-pill { font-size: 11px; background: var(--ip-bg-soft); color: var(--ip-accent-dark); padding: 5px 12px; border-radius: 999px; font-weight: 600; border: 1px solid rgba(74,107,26,0.2); }\n  .ip-ing-pill.dark { background: var(--ip-bg-dark); color: var(--ip-accent); }\n\n  /* Compare */\n\n  /* Guarantee */\n  .ip-guarantee { background: var(--ip-bg-dark); }\n  .ip-guarantee-inner { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; max-width: 620px; margin: 0 auto; }\n  .ip-guarantee-icon { font-size: 52px; line-height: 1; }\n  .ip-guarantee h2 { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(22px, 3.2vw, 36px); font-weight: 900; margin: 0; color: #f5f0e8; line-height: 1.15; }\n  .ip-gua